# ---------------------------------------------------------------------------
#  내 화장대 — 환경변수 예시 (6차시)
#  이 파일을 복사해 .env.local 로 저장하고 값을 채우세요. (.env* 는 git 에 올라가지 않습니다)
#  두 값이 모두 있으면 Supabase 저장 모드, 비어 있으면 localStorage 모드로 동작합니다.
# ---------------------------------------------------------------------------

# Supabase 대시보드 > Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Supabase 대시보드 > Project Settings > API > anon public key
VITE_SUPABASE_ANON_KEY=

# (선택) YouTube Data API v3 키 — 있으면 튜토리얼의 "영상으로 배우기"에 종류별 최신 영상이 실시간으로 뜹니다.
# 없으면 앱에 내장된 큐레이션 영상 목록을 보여줍니다. Google Cloud 콘솔에서 HTTP 리퍼러(배포 도메인)로 키를 제한하세요.
VITE_YOUTUBE_API_KEY=
