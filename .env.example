# ---------------------------------------------------------------------------
#  내 화장대 — 환경변수 예시 (6차시)
#  이 파일을 복사해 .env.local 로 저장하고 값을 채우세요. (.env* 는 git 에 올라가지 않습니다)
#  두 값이 모두 있으면 Supabase 저장 모드, 비어 있으면 localStorage 모드로 동작합니다.
# ---------------------------------------------------------------------------

# Supabase 대시보드 > Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Supabase 대시보드 > Project Settings > API > anon public key
VITE_SUPABASE_ANON_KEY=

# (선택) YouTube Data API v3 키 — 있으면 튜토리얼의 "영상으로 배우기"에 종류별 최신 영상이 실시간으로 뜹니다.
# 없으면 앱에 내장된 큐레이션 영상 목록을 보여줍니다. Google Cloud 콘솔에서 HTTP 리퍼러(배포 도메인)로 키를 제한하세요.
VITE_YOUTUBE_API_KEY=

# (선택) 실제 상품 사진 — 카카오 Daum 이미지 검색 [권장, 지금 발급 가능]
# developers.kakao.com → 내 애플리케이션 → 앱 만들기 → 앱 키 → REST API 키
# VITE_ 접두사가 없어 브라우저에 노출되지 않고, 개발 서버와 Vercel 함수(/api/product-image)에서만 읽습니다.
# 이용약관: 검색 결과는 실시간 표시용이며 저장·재배포하지 않습니다. 앱은 출처와 원본 링크를 함께 표시합니다.
KAKAO_REST_API_KEY=

# (선택) 실제 상품 사진 — 네이버 쇼핑 검색 API
# 2026-07-31 자로 네이버 개발자센터의 검색 API 신규 발급이 끝났습니다(쇼핑 검색은 대체 API 없이 종료).
# 그 전에 발급받아 둔 키가 있으면 아래에 넣으면 카카오보다 먼저 시도합니다. 없으면 비워 두세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) 설치형 앱(Capacitor)에서 /api 함수를 호출할 배포 주소. 웹에서는 비워 두면 같은 도메인을 씁니다.
# 예: VITE_API_BASE=https://my-vanity.vercel.app
VITE_API_BASE=
