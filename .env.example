# ---------------------------------------------------------------------------
#  내 화장대 — 환경변수 예시 (6차시)
#  이 파일을 복사해 .env.local 로 저장하고 값을 채우세요. (.env* 는 git 에 올라가지 않습니다)
#  두 값이 모두 있으면 Supabase 저장 모드, 비어 있으면 localStorage 모드로 동작합니다.
# ---------------------------------------------------------------------------

# Supabase 대시보드 > Project Settings > API > Project URL
VITE_SUPABASE_URL=

# Supabase 대시보드 > Project Settings > API > anon public key
VITE_SUPABASE_ANON_KEY=
